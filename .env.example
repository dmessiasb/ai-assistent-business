# ==========================================================
# CONFIGURAÇÃO DO WHATSAPP & AI CORE HUB (CUSTO ZERO)
# ==========================================================
PORT=3000
HOST=0.0.0.0

# Chave mestre para proteger rotas administrativas do Hub
HUB_MASTER_API_KEY=dev-master-key-change-me

# Google AI Studio (Grátis em https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Caminho do banco SQLite (Em modo WAL para alta performance na VM e2-micro)
SQLITE_DB_PATH=./data/database.sqlite

# Pasta onde ficam salvas as sessões conectadas do WhatsApp (Baileys)
WHATSAPP_AUTH_DIR=./data/whatsapp_sessions
